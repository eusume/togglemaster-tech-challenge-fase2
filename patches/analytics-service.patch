+"""Idempotent SQS consumption. No SDK clients or background workers at import."""
+import json
+import logging
+
+from botocore.exceptions import ClientError
+
+log = logging.getLogger(__name__)
+FIELDS = ('user_id', 'flag_name', 'result', 'timestamp')
+
+
+def event_item(message):
+    """An explicit producer ID survives republishing; SQS ID survives redelivery.
+
+    Content is deliberately not an identity: two independent messages with the
+    same payload are valid separate events when the producer supplies no ID.
+    """
+    body = json.loads(message['Body'])
+    if not isinstance(body, dict):
+        raise ValueError('Event body must be an object')
+    for field in ('user_id', 'flag_name', 'timestamp'):
+        if not isinstance(body.get(field), str):
+            raise ValueError('Event string field has an invalid type')
+    if type(body.get('result')) is not bool:
+        raise ValueError('Event result must be a boolean')
+    if 'event_id' in body:
+        source_id = body['event_id']
+        prefix = 'producer:'
+    else:
+        source_id = message['MessageId']
+        prefix = 'sqs:'
+    if not isinstance(source_id, str) or not source_id.strip():
+        raise ValueError('Event identity must be a nonempty string')
+    event_id = prefix + source_id
+    if len(event_id.encode('utf-8')) > 2048:
+        raise ValueError('Event identity exceeds DynamoDB partition key size')
+    return {
+        'event_id': {'S': event_id},
+        'user_id': {'S': body['user_id']},
+        'flag_name': {'S': body['flag_name']},
+        'result': {'BOOL': body['result']},
+        'timestamp': {'S': body['timestamp']},
+    }
+
+
+def process_event(message, *, dynamodb, sqs, table, queue_url):
+    """Acknowledge only after persistence or a strongly verified duplicate.
+
+    A conflict, invalid message or SDK error remains in SQS for redelivery.
+    A delete failure after a committed write is safe: the next attempt follows
+    the duplicate path. Conditional writes arbitrate across processes/replicas.
+    """
+    try:
+        item = event_item(message)
+        receipt = message['ReceiptHandle']
+        if not isinstance(receipt, str) or not receipt:
+            raise ValueError('Receipt handle missing')
+    except (ValueError, TypeError, KeyError):
+        log.error('Invalid event; message retained without logging its body')
+        return 'invalid'
+
+    try:
+        outcome = 'stored'
+        try:
+            dynamodb.put_item(
+                TableName=table,
+                Item=item,
+                ConditionExpression='attribute_not_exists(#event_id)',
+                ExpressionAttributeNames={'#event_id': 'event_id'},
+            )
+        except ClientError as error:
+            if error.response.get('Error', {}).get('Code') != 'ConditionalCheckFailedException':
+                raise
+            # Read only AFTER the failed atomic put. Strong consistency avoids
+            # acknowledging a collision or an ambiguous/absent previous write.
+            existing = dynamodb.get_item(
+                TableName=table,
+                Key={'event_id': item['event_id']},
+                ConsistentRead=True,
+            ).get('Item')
+            if not existing:
+                log.warning('Conditional failure without a readable item; message retained')
+                return 'retry'
+            if any(existing.get(field) != item[field] for field in FIELDS):
+                log.error('Event identity conflicts with persisted content; message retained')
+                return 'conflict'
+            outcome = 'duplicate'
+
+        sqs.delete_message(QueueUrl=queue_url, ReceiptHandle=receipt)
+        log.info('Event processed: %s', outcome)
+        return outcome
+    except Exception as error:
+        # Do not log SDK error bodies, event contents, URLs or credential data.
+        code = error.response.get('Error', {}).get('Code', 'ClientError') if isinstance(error, ClientError) else type(error).__name__
+        log.warning('Event not acknowledged; retry permitted (%s)', code)
+        return 'retry'
