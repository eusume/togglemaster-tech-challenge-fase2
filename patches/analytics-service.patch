@@ -0,0 +1,127 @@
+import concurrent.futures
+import copy
+import json
+from pathlib import Path
+import sys
+import threading
+import unittest
+from unittest.mock import Mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from botocore.exceptions import ClientError, ReadTimeoutError
+from event_processing import event_item, process_event
+
+
+def error(code, operation='PutItem'):
+    return ClientError({'Error': {'Code': code, 'Message': 'test failure'}}, operation)
+
+
+def message(mid='message-1', event_id=None, **changes):
+    body={'user_id':'user-1','flag_name':'test-flag','result':True,'timestamp':'2026-10-30T23:00:00.123456789Z'}
+    if event_id is not None:body['event_id']=event_id
+    body.update(changes)
+    return {'MessageId':mid,'Body':json.dumps(body),'ReceiptHandle':'receipt-'+mid}
+
+
+class AtomicDB:
+    def __init__(self):
+        self.lock=threading.Lock();self.items={};self.put_error=None;self.get_error=None;self.after_commit=False
+    def put_item(self, **args):
+        assert args['ConditionExpression']=='attribute_not_exists(#event_id)'
+        assert args['ExpressionAttributeNames']=={'#event_id':'event_id'}
+        with self.lock:
+            if self.put_error:raise self.put_error
+            key=args['Item']['event_id']['S']
+            if key in self.items:raise error('ConditionalCheckFailedException')
+            self.items[key]=copy.deepcopy(args['Item'])
+            if self.after_commit:
+                self.after_commit=False
+                raise ReadTimeoutError(endpoint_url='http://local.invalid')
+    def get_item(self, **args):
+        assert args['ConsistentRead'] is True
+        if self.get_error:raise self.get_error
+        with self.lock:return {'Item':copy.deepcopy(self.items.get(args['Key']['event_id']['S']))}
+
+
+class Processing(unittest.TestCase):
+    def setUp(self):self.db=AtomicDB();self.sqs=Mock()
+    def process(self,m):return process_event(m,dynamodb=self.db,sqs=self.sqs,table='test-table',queue_url='http://local.invalid/queue')
+    def test_first_write_and_ack(self):
+        self.assertEqual(self.process(message()),'stored');self.assertEqual(len(self.db.items),1)
+        self.sqs.delete_message.assert_called_once_with(QueueUrl='http://local.invalid/queue',ReceiptHandle='receipt-message-1')
+    def test_redelivery_new_receipt(self):
+        m=message();self.process(m);m['ReceiptHandle']='new-receipt'
+        self.assertEqual(self.process(m),'duplicate');self.assertEqual(len(self.db.items),1)
+        self.assertEqual(self.sqs.delete_message.call_args.kwargs['ReceiptHandle'],'new-receipt')
+    def test_producer_id_survives_republication(self):
+        self.process(message('a','stable-event'))
+        self.assertEqual(self.process(message('b','stable-event')),'duplicate');self.assertEqual(len(self.db.items),1)
+    def test_separate_events_with_identical_payload_are_kept(self):
+        self.process(message('a'));self.process(message('b'));self.assertEqual(len(self.db.items),2)
+    def test_concurrency_across_independent_consumers(self):
+        def consumer(i):
+            return process_event(message(str(i),'same-event'),dynamodb=self.db,sqs=self.sqs,table='test-table',queue_url='http://local.invalid/queue')
+        with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:outcomes=list(pool.map(consumer,range(100)))
+        self.assertEqual(outcomes.count('stored'),1);self.assertEqual(outcomes.count('duplicate'),99)
+        self.assertEqual(len(self.db.items),1);self.assertEqual(self.sqs.delete_message.call_count,100)
+    def test_concurrent_legacy_redelivery(self):
+        with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:outcomes=list(pool.map(lambda _:self.process(message()),range(100)))
+        self.assertEqual(outcomes.count('stored'),1);self.assertEqual(len(self.db.items),1)
+    def test_transient_write_failure_not_acknowledged(self):
+        self.db.put_error=error('ProvisionedThroughputExceededException')
+        self.assertEqual(self.process(message()),'retry');self.sqs.delete_message.assert_not_called()
+        self.db.put_error=None;self.assertEqual(self.process(message()),'stored')
+    def test_timeout_after_committed_write_then_retry(self):
+        self.db.after_commit=True;self.assertEqual(self.process(message()),'retry');self.sqs.delete_message.assert_not_called()
+        self.assertEqual(self.process(message()),'duplicate');self.assertEqual(len(self.db.items),1)
+    def test_delete_failure_after_write_then_retry(self):
+        self.sqs.delete_message.side_effect=error('RequestThrottled','DeleteMessage')
+        self.assertEqual(self.process(message()),'retry');self.assertEqual(len(self.db.items),1)
+        self.sqs.delete_message.side_effect=None
+        self.assertEqual(self.process(message()),'duplicate');self.assertEqual(len(self.db.items),1)
+    def test_read_failure_not_acknowledged(self):
+        self.process(message());self.sqs.reset_mock();self.db.get_error=error('InternalServerError','GetItem')
+        self.assertEqual(self.process(message()),'retry');self.sqs.delete_message.assert_not_called()
+    def test_absent_item_after_condition_failure_not_acknowledged(self):
+        self.db.put_error=error('ConditionalCheckFailedException')
+        self.assertEqual(self.process(message()),'retry');self.sqs.delete_message.assert_not_called()
+    def test_conflicting_id_not_overwritten_or_acknowledged(self):
+        self.process(message('a','event'));self.sqs.reset_mock()
+        self.assertEqual(self.process(message('b','event',result=False)),'conflict')
+        self.sqs.delete_message.assert_not_called();self.assertTrue(next(iter(self.db.items.values()))['result']['BOOL'])
+    def test_invalid_json_not_acknowledged(self):
+        m=message();m['Body']='{'
+        self.assertEqual(self.process(m),'invalid');self.sqs.delete_message.assert_not_called()
+    def test_result_must_be_boolean(self):
+        for value in ('true',1,None):self.assertEqual(self.process(message(result=value)),'invalid')
+        self.assertFalse(self.db.items)
+    def test_false_result_is_valid(self):self.assertEqual(self.process(message(result=False)),'stored')
+    def test_missing_identity_not_acknowledged(self):
+        m=message();m.pop('MessageId');self.assertEqual(self.process(m),'invalid');self.sqs.delete_message.assert_not_called()
+    def test_explicit_invalid_identity_does_not_fall_back(self):
+        self.assertEqual(self.process(message(event_id='')),'invalid');self.sqs.delete_message.assert_not_called()
+    def test_missing_receipt_does_not_write(self):
+        m=message();m.pop('ReceiptHandle');self.assertEqual(self.process(m),'invalid');self.assertFalse(self.db.items)
+    def test_source_namespaces_cannot_collide(self):
+        self.assertNotEqual(event_item(message('a'))['event_id'],event_item(message('b','sqs:a'))['event_id'])
+    def test_partition_key_byte_limit(self):
+        self.assertEqual(self.process(message(event_id='é'*1024)),'invalid');self.assertFalse(self.db.items)
+    def test_no_delete_before_put_or_duplicate_confirmation(self):
+        calls=[];original=self.db.put_item
+        def put(**args):calls.append('put');return original(**args)
+        self.db.put_item=put;self.sqs.delete_message.side_effect=lambda **kwargs:calls.append('delete')
+        self.process(message());self.assertEqual(calls,['put','delete'])
+    def test_botocore_contract_without_network(self):
+        import boto3
+        from botocore.stub import Stubber
+        db=boto3.client('dynamodb',region_name='us-east-1',endpoint_url='http://127.0.0.1:1',aws_access_key_id='local',aws_secret_access_key='local')
+        m=message();item=event_item(m)
+        with Stubber(db) as stub:
+            stub.add_response('put_item',{}, {'TableName':'test-table','Item':item,'ConditionExpression':'attribute_not_exists(#event_id)','ExpressionAttributeNames':{'#event_id':'event_id'}})
+            stub.add_client_error('put_item',service_error_code='ConditionalCheckFailedException')
+            stub.add_response('get_item',{'Item':item},{'TableName':'test-table','Key':{'event_id':item['event_id']},'ConsistentRead':True})
+            for expected in ('stored','duplicate'):
+                self.assertEqual(process_event(m,dynamodb=db,sqs=self.sqs,table='test-table',queue_url='http://local.invalid/queue'),expected)
+            stub.assert_no_pending_responses()
+
+if __name__=='__main__':unittest.main()
