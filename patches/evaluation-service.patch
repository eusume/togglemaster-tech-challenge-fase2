@@ -0,0 +1,283 @@
+package main
+
+import (
+	"context"
+	"crypto/md5"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"regexp"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/aws/client"
+	"github.com/aws/aws-sdk-go/aws/credentials"
+	"github.com/aws/aws-sdk-go/aws/request"
+	"github.com/aws/aws-sdk-go/aws/session"
+	"github.com/aws/aws-sdk-go/service/sqs"
+)
+
+type recordingSender struct {
+	mu       sync.Mutex
+	bodies   []string
+	callback func(aws.Context, int) error
+}
+
+func (s *recordingSender) SendMessageWithContext(ctx aws.Context, input *sqs.SendMessageInput, _ ...request.Option) (*sqs.SendMessageOutput, error) {
+	s.mu.Lock()
+	s.bodies = append(s.bodies, aws.StringValue(input.MessageBody))
+	index := len(s.bodies)
+	s.mu.Unlock()
+	if s.callback != nil {
+		if err := s.callback(ctx, index); err != nil {
+			return nil, err
+		}
+	}
+	return &sqs.SendMessageOutput{MessageId: aws.String(fmt.Sprintf("local-message-%d", index))}, nil
+}
+
+func eventForTest(t *testing.T) EvaluationEvent {
+	t.Helper()
+	event, err := newEvaluationEvent("same-user", "same-flag", true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return event
+}
+
+func TestNewLogicalEventHasRandomUUIDv4(t *testing.T) {
+	event := eventForTest(t)
+	if !regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`).MatchString(event.EventID) {
+		t.Fatal("invalid UUID v4")
+	}
+	if event.Timestamp.Location() != time.UTC || event.UserID != "same-user" || event.FlagName != "same-flag" || !event.Result {
+		t.Fatal("event business fields changed")
+	}
+}
+
+func TestIndependentEvaluationsRemainDistinctWithIdenticalFieldsAndClock(t *testing.T) {
+	first, second := eventForTest(t), eventForTest(t)
+	second.Timestamp = first.Timestamp
+	if first.EventID == second.EventID {
+		t.Fatal("independent events shared identity")
+	}
+}
+
+func TestConcurrentIndependentEvaluations(t *testing.T) {
+	const count = 200
+	sender := &recordingSender{}
+	var wg sync.WaitGroup
+	for i := 0; i < count; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			event, err := newEvaluationEvent("same-user", "same-flag", true)
+			if err == nil {
+				err = publishEvaluationEvent(context.Background(), sender, "http://local.invalid/queue", event)
+			}
+			if err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	wg.Wait()
+	ids := map[string]bool{}
+	for _, body := range sender.bodies {
+		var event EvaluationEvent
+		if err := json.Unmarshal([]byte(body), &event); err != nil {
+			t.Fatal(err)
+		}
+		ids[event.EventID] = true
+	}
+	if len(ids) != count {
+		t.Fatalf("want %d independent events, got %d", count, len(ids))
+	}
+}
+
+func TestRepublicationAfterAmbiguousFailurePreservesWholeEvent(t *testing.T) {
+	sender := &recordingSender{callback: func(_ aws.Context, attempt int) error {
+		if attempt == 1 {
+			return errors.New("local ambiguous publication result")
+		}
+		return nil
+	}}
+	event := eventForTest(t)
+	before := event
+	if publishEvaluationEvent(context.Background(), sender, "http://local.invalid/queue", event) == nil {
+		t.Fatal("expected first publication failure")
+	}
+	if err := publishEvaluationEvent(context.Background(), sender, "http://local.invalid/queue", event); err != nil {
+		t.Fatal(err)
+	}
+	if sender.bodies[0] != sender.bodies[1] || event != before {
+		t.Fatal("retry changed event identity, timestamp or content")
+	}
+}
+
+func TestConcurrentRepublicationOfOneEvent(t *testing.T) {
+	event := eventForTest(t)
+	sender := &recordingSender{}
+	var wg sync.WaitGroup
+	for i := 0; i < 50; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if err := publishEvaluationEvent(context.Background(), sender, "http://local.invalid/queue", event); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	wg.Wait()
+	for _, body := range sender.bodies {
+		if body != sender.bodies[0] {
+			t.Fatal("concurrent retry changed payload")
+		}
+	}
+}
+
+func TestPublisherRejectsUnidentifiedEventInsteadOfGeneratingNewID(t *testing.T) {
+	sender := &recordingSender{}
+	event := eventForTest(t)
+	event.EventID = ""
+	if publishEvaluationEvent(context.Background(), sender, "http://local.invalid/queue", event) == nil || len(sender.bodies) != 0 {
+		t.Fatal("unidentified event was sent")
+	}
+}
+
+func TestPublisherRejectsMissingTimestamp(t *testing.T) {
+	event := eventForTest(t)
+	event.Timestamp = time.Time{}
+	sender := &recordingSender{}
+	if publishEvaluationEvent(context.Background(), sender, "http://local.invalid/queue", event) == nil || len(sender.bodies) != 0 {
+		t.Fatal("event timestamp was generated during retry")
+	}
+}
+
+func TestSerializationFailureDoesNotPublish(t *testing.T) {
+	event := eventForTest(t)
+	event.Timestamp = time.Date(10000, 1, 1, 0, 0, 0, 0, time.UTC)
+	sender := &recordingSender{}
+	if publishEvaluationEvent(context.Background(), sender, "http://local.invalid/queue", event) == nil || len(sender.bodies) != 0 {
+		t.Fatal("invalid serialization was sent")
+	}
+}
+
+func TestEntropyFailureReturnsNoIdentity(t *testing.T) {
+	id, err := newEventID(strings.NewReader("short"))
+	if err == nil || id != "" {
+		t.Fatal("entropy failure fabricated identity")
+	}
+}
+
+func TestPublicationContextDeadline(t *testing.T) {
+	sender := &recordingSender{callback: func(ctx aws.Context, _ int) error {
+		<-ctx.Done()
+		return ctx.Err()
+	}}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	if err := publishEvaluationEvent(ctx, sender, "http://local.invalid/queue", eventForTest(t)); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("deadline not propagated: %v", err)
+	}
+}
+
+func TestAsynchronousWrapperSetsDeadline(t *testing.T) {
+	sender := &recordingSender{callback: func(ctx aws.Context, _ int) error {
+		deadline, ok := ctx.Deadline()
+		if !ok || time.Until(deadline) > 10*time.Second {
+			t.Error("publication has no bounded deadline")
+		}
+		return nil
+	}}
+	app := &App{SqsSvc: sender, SqsQueueURL: "http://local.invalid/queue"}
+	app.sendEvaluationEvent(eventForTest(t))
+}
+
+func TestDisabledPublicationRemainsSafe(t *testing.T) {
+	(&App{}).sendEvaluationEvent(eventForTest(t))
+	sender := &recordingSender{}
+	(&App{SqsSvc: sender}).sendEvaluationEvent(eventForTest(t))
+	if len(sender.bodies) != 0 {
+		t.Fatal("disabled publication called SDK")
+	}
+}
+
+func TestEventContractIsAdditiveAndPreservesFalse(t *testing.T) {
+	event := eventForTest(t)
+	event.Result = false
+	body, _ := json.Marshal(event)
+	var legacy struct {
+		UserID string `json:"user_id"`
+		FlagName string `json:"flag_name"`
+		Result bool `json:"result"`
+		Timestamp time.Time `json:"timestamp"`
+	}
+	if err := json.Unmarshal(body, &legacy); err != nil || legacy.UserID != event.UserID || legacy.FlagName != event.FlagName || legacy.Result || !legacy.Timestamp.Equal(event.Timestamp) {
+		t.Fatal("legacy JSON fields incompatible")
+	}
+}
+
+func TestHealthContractUnchanged(t *testing.T) {
+	recorder := httptest.NewRecorder()
+	(&App{}).healthHandler(recorder, httptest.NewRequest(http.MethodGet, "/health", nil))
+	if recorder.Code != 200 || strings.TrimSpace(recorder.Body.String()) != `{"status":"ok"}` {
+		t.Fatal("health response changed")
+	}
+}
+
+func TestRealSDKRetryPreservesSerializedEvent(t *testing.T) {
+	var mu sync.Mutex
+	var bodies []string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var payload string
+		isJSON := strings.Contains(r.Header.Get("Content-Type"), "json")
+		if isJSON {
+			var input map[string]interface{}
+			json.NewDecoder(r.Body).Decode(&input)
+			payload, _ = input["MessageBody"].(string)
+		} else {
+			r.ParseForm()
+			payload = r.Form.Get("MessageBody")
+		}
+		mu.Lock()
+		bodies = append(bodies, payload)
+		attempt := len(bodies)
+		mu.Unlock()
+		if attempt == 1 {
+			w.WriteHeader(500)
+			if isJSON {
+				fmt.Fprint(w, `{"__type":"InternalError","message":"injected failure after accepting body"}`)
+			} else {
+				fmt.Fprint(w, `<ErrorResponse><Error><Code>InternalError</Code><Message>local test</Message></Error></ErrorResponse>`)
+			}
+			return
+		}
+		sum := md5.Sum([]byte(payload))
+		checksum := hex.EncodeToString(sum[:])
+		if isJSON {
+			w.Header().Set("Content-Type", "application/x-amz-json-1.0")
+			json.NewEncoder(w).Encode(map[string]string{"MD5OfMessageBody": checksum, "MessageId": "local-message"})
+		} else {
+			fmt.Fprintf(w, `<SendMessageResponse><SendMessageResult><MD5OfMessageBody>%s</MD5OfMessageBody><MessageId>local-message</MessageId></SendMessageResult></SendMessageResponse>`, checksum)
+		}
+	}))
+	defer server.Close()
+	sess, err := session.NewSession(&aws.Config{Region: aws.String("us-east-1"), Endpoint: aws.String(server.URL), Credentials: credentials.NewStaticCredentials("local", "local", ""), Retryer: client.DefaultRetryer{NumMaxRetries: 2, MinRetryDelay: time.Millisecond, MaxRetryDelay: 2*time.Millisecond}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := publishEvaluationEvent(context.Background(), sqs.New(sess), server.URL+"/queue", eventForTest(t)); err != nil {
+		t.Fatal(err)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if len(bodies) != 2 || bodies[0] == "" || bodies[0] != bodies[1] {
+		t.Fatal("real SDK retry changed message body")
+	}
+}
