@@ -0,0 +1,63 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/aws/session"
+)
+
+// Exerce o mesmo session.NewSession de main, sem credenciais de ambiente ou AWS.
+func TestPodCredentialChainAndTokenRotation(t *testing.T) {
+	directory := t.TempDir()
+	tokenPath := filepath.Join(directory, "token")
+	if err := os.WriteFile(tokenPath, []byte("local-token-one"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		token, err := os.ReadFile(tokenPath)
+		if err != nil || r.Header.Get("Authorization") != string(token) {
+			w.WriteHeader(403)
+			return
+		}
+		calls++
+		key := "local-key-one"
+		if calls > 1 {
+			key = "local-key-two"
+		}
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]string{"AccessKeyId": key, "SecretAccessKey": "local-secret", "Token": "local-session", "Expiration": time.Now().Add(time.Hour).UTC().Format(time.RFC3339)})
+	}))
+	defer server.Close()
+	for _, name := range []string{"AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_PROFILE", "AWS_WEB_IDENTITY_TOKEN_FILE", "AWS_ROLE_ARN", "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI"} {
+		t.Setenv(name, "")
+	}
+	t.Setenv("AWS_SHARED_CREDENTIALS_FILE", filepath.Join(directory, "absent"))
+	t.Setenv("AWS_CONFIG_FILE", filepath.Join(directory, "absent-config"))
+	t.Setenv("AWS_EC2_METADATA_DISABLED", "true")
+	t.Setenv("AWS_CONTAINER_CREDENTIALS_FULL_URI", server.URL)
+	t.Setenv("AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE", tokenPath)
+	sess, err := session.NewSession(&aws.Config{Region: aws.String("us-east-1")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	first, err := sess.Config.Credentials.Get()
+	if err != nil || first.AccessKeyID != "local-key-one" {
+		t.Fatalf("provider inicial falhou: %v", err)
+	}
+	if err := os.WriteFile(tokenPath, []byte("local-token-two"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	sess.Config.Credentials.Expire()
+	second, err := sess.Config.Credentials.Get()
+	if err != nil || second.AccessKeyID != "local-key-two" || calls != 2 {
+		t.Fatalf("refresh falhou: %v", err)
+	}
+}
