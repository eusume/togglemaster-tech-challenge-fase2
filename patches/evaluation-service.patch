+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "ToggleMaster Evaluation Event: stable producer identity",
+  "type": "object",
+  "required": ["event_id", "user_id", "flag_name", "result", "timestamp"],
+  "properties": {
+    "event_id": {
+      "type": "string",
+      "format": "uuid",
+      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
+      "description": "Random UUID v4 created once per logical evaluation. Reuse unchanged on republication."
+    },
+    "user_id": {"type": "string"},
+    "flag_name": {"type": "string"},
+    "result": {"type": "boolean"},
+    "timestamp": {"type": "string", "format": "date-time", "description": "UTC RFC3339 timestamp created with the event; preserved on retry."}
+  },
+  "additionalProperties": true
+}
