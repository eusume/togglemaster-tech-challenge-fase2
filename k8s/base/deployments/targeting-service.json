{
    "spec":  {
                 "selector":  {
                                  "matchLabels":  {
                                                      "app.kubernetes.io/name":  "targeting-service"
                                                  }
                              },
                 "strategy":  {
                                  "rollingUpdate":  {
                                                        "maxUnavailable":  0,
                                                        "maxSurge":  1
                                                    },
                                  "type":  "RollingUpdate"
                              },
                 "revisionHistoryLimit":  3,
                 "minReadySeconds":  5,
                 "progressDeadlineSeconds":  300,
                 "template":  {
                                  "metadata":  {
                                                   "labels":  {
                                                                  "app.kubernetes.io/name":  "targeting-service",
                                                                  "app.kubernetes.io/part-of":  "togglemaster"
                                                              }
                                               },
                                  "spec":  {
                                               "securityContext":  {
                                                                       "runAsUser":  10001,
                                                                       "seccompProfile":  {
                                                                                              "type":  "RuntimeDefault"
                                                                                          },
                                                                       "runAsNonRoot":  true,
                                                                       "fsGroup":  10001,
                                                                       "runAsGroup":  10001
                                                                   },
                                               "volumes":  [
                                                               {
                                                                   "emptyDir":  {
                                                                                    "sizeLimit":  "32Mi"
                                                                                },
                                                                   "name":  "tmp"
                                                               }
                                                           ],
                                               "containers":  [
                                                                  {
                                                                      "name":  "targeting-service",
                                                                      "image":  "example.invalid/togglemaster-targeting:REPLACE_IMAGE_TAG",
                                                                      "imagePullPolicy":  "IfNotPresent",
                                                                      "ports":  [
                                                                                    {
                                                                                        "containerPort":  8003,
                                                                                        "protocol":  "TCP",
                                                                                        "name":  "http"
                                                                                    }
                                                                                ],
                                                                      "envFrom":  [
                                                                                      {
                                                                                          "configMapRef":  {
                                                                                                               "name":  "targeting-service-config"
                                                                                                           }
                                                                                      },
                                                                                      {
                                                                                          "secretRef":  {
                                                                                                            "name":  "targeting-secrets"
                                                                                                        }
                                                                                      }
                                                                                  ],
                                                                      "resources":  {
                                                                                        "limits":  {
                                                                                                       "cpu":  "500m",
                                                                                                       "memory":  "256Mi"
                                                                                                   },
                                                                                        "requests":  {
                                                                                                         "cpu":  "100m",
                                                                                                         "memory":  "128Mi"
                                                                                                     }
                                                                                    },
                                                                      "startupProbe":  {
                                                                                           "periodSeconds":  5,
                                                                                           "failureThreshold":  30,
                                                                                           "timeoutSeconds":  2,
                                                                                           "httpGet":  {
                                                                                                           "path":  "/health",
                                                                                                           "port":  "http"
                                                                                                       }
                                                                                       },
                                                                      "readinessProbe":  {
                                                                                             "periodSeconds":  5,
                                                                                             "failureThreshold":  3,
                                                                                             "timeoutSeconds":  2,
                                                                                             "successThreshold":  1,
                                                                                             "httpGet":  {
                                                                                                             "path":  "/health",
                                                                                                             "port":  "http"
                                                                                                         }
                                                                                         },
                                                                      "livenessProbe":  {
                                                                                            "periodSeconds":  10,
                                                                                            "failureThreshold":  3,
                                                                                            "timeoutSeconds":  2,
                                                                                            "httpGet":  {
                                                                                                            "path":  "/health",
                                                                                                            "port":  "http"
                                                                                                        }
                                                                                        },
                                                                      "securityContext":  {
                                                                                              "allowPrivilegeEscalation":  false,
                                                                                              "readOnlyRootFilesystem":  true,
                                                                                              "capabilities":  {
                                                                                                                   "drop":  [
                                                                                                                                "ALL"
                                                                                                                            ]
                                                                                                               }
                                                                                          },
                                                                      "volumeMounts":  [
                                                                                           {
                                                                                               "mountPath":  "/tmp",
                                                                                               "name":  "tmp"
                                                                                           }
                                                                                       ],
                                                                      "lifecycle":  {
                                                                                        "preStop":  {
                                                                                                        "exec":  {
                                                                                                                     "command":  [
                                                                                                                                     "/bin/sh",
                                                                                                                                     "-c",
                                                                                                                                     "sleep 10"
                                                                                                                                 ]
                                                                                                                 }
                                                                                                    }
                                                                                    }
                                                                  }
                                                              ],
                                               "terminationGracePeriodSeconds":  45,
                                               "automountServiceAccountToken":  false,
                                               "nodeSelector":  {
                                                                    "kubernetes.io/os":  "linux",
                                                                    "kubernetes.io/arch":  "amd64"
                                                                },
                                               "serviceAccountName":  "targeting-service"
                                           }
                              },
                 "replicas":  1
             },
    "metadata":  {
                     "name":  "targeting-service",
                     "namespace":  "togglemaster",
                     "labels":  {
                                    "app.kubernetes.io/part-of":  "togglemaster"
                                }
                 },
    "apiVersion":  "apps/v1",
    "kind":  "Deployment"
}
